# Generated evidence is never committed; only the .gitkeep placeholders that
# preserve the directory structure are. Re-including a directory (!evidence/
# logs/) is not enough on its own — without the following wildcard, git
# descends into it and tracks every generated log.
evidence/*
!evidence/.gitkeep
!evidence/logs/
evidence/logs/*
!evidence/logs/.gitkeep
!evidence/junit/
evidence/junit/*
!evidence/junit/.gitkeep
cpp/build/
.serena/
learning/.progress.json
learning/.progress.tmp
learning/.corrupt.json
learning/*.corrupt.json
